{
  "rules": {
    "presence": {
      "$groupId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "rtc": {
      "$groupId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "calls": {
      "$groupId": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "pings": {
      "$groupId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["ts"]
      }
    }
  }
}
